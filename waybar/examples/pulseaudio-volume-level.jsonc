{
  "custom/volume": {
    "exec": "python3 ~/.config/waybar/scripts/volume-status.py",
    "return-type": "json",
    "interval": 1,
    "on-click": "omarchy-launch-audio",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "tooltip": true
  }
}
