# --- Instant prompt (keep at top) ----------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- PATH ---------------------------------------------------------------
path=(
    $HOME/bin
    $HOME/.local/bin
    $path
    /usr/share/steam/compatibilitytools.d/proton-ge-custom/
)
typeset -U path
path=($^path(N-/))
export PATH

# --- Environment --------------------------------------------------------
export EDITOR=nvim
export SUDO_EDITOR=nvim

# --- History ------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt APPEND_HISTORY HIST_IGNORE_SPACE HIST_IGNORE_DUPS SHARE_HISTORY

# --- Completion ---------------------------------------------------------
zmodload zsh/complist
autoload -Uz compinit && compinit
autoload -Uz bashcompinit && bashcompinit
zstyle ':completion:*' menu select
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char
bindkey -M menuselect '^[[Z' reverse-menu-complete  # Shift+Tab to go back

# --- Plugins ------------------------------------------------------------
source ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
# zsh-syntax-highlighting must be sourced last among plugins
source ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# --- Tools --------------------------------------------------------------
eval "$(zoxide init zsh)"
source <(fzf --zsh)

# --- fnm (Node version manager) -----------------------------------------
eval "$(fnm env --use-on-cd --shell zsh)"

# --- Aliases ------------------------------------------------------------
source "$HOME/.zsh_aliases"

# --- Misc ---------------------------------------------------------------
[[ -e "/home/vladkarok/lib/oracle-cli/lib/python3.13/site-packages/oci_cli/bin/oci_autocomplete.sh" ]] && \
    source "/home/vladkarok/lib/oracle-cli/lib/python3.13/site-packages/oci_cli/bin/oci_autocomplete.sh"

. "$HOME/.local/share/../bin/env"

# --- Keybindings (after plugins to prevent override) --------------------
bindkey -e
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line

# --- Prompt (keep last) -------------------------------------------------
source ~/.oh-my-zsh/custom/themes/powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
export PATH="$PATH:$HOME/.dual-graph"

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<

# >>> agterm agent-status >>>
source '/home/vladkarok/.config/agterm/agent-status/shell/integration.sh'
# <<< agterm agent-status <<<
