#!/usr/bin/env python3
"""Gamma-corrected display brightness control for Omarchy.

All user-facing percentages are linear perceived brightness values. The script
maps them to raw backlight values through one curve so keys, Waybar scroll, and
the popup slider stay consistent.
"""

from __future__ import annotations

import json
import math
import os
import re
import subprocess
import sys
from pathlib import Path


GAMMA = float(os.environ.get("OMARCHY_BRIGHTNESS_GAMMA", "3.0"))
MIN_LINEAR = float(os.environ.get("OMARCHY_BRIGHTNESS_MIN", "10"))
DEFAULT_DEVICE = os.environ.get("OMARCHY_BRIGHTNESS_DEVICE", "nvidia_wmi_ec_backlight")
STOCK_BIN = Path.home() / ".local/share/omarchy/bin"


def run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        cmd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=check,
    )


def output(cmd: list[str]) -> str:
    return run(cmd).stdout.strip()


def device_exists(device: str) -> bool:
    return (Path("/sys/class/backlight") / device).exists()


def choose_device(explicit: str | None = None) -> str:
    if explicit:
        return explicit

    if DEFAULT_DEVICE and device_exists(DEFAULT_DEVICE):
        return DEFAULT_DEVICE

    backlight = Path("/sys/class/backlight")
    for pattern in ("nvidia_wmi_ec_backlight", "amdgpu_bl*", "intel_backlight", "acpi_video*"):
        matches = sorted(backlight.glob(pattern))
        if matches:
            return matches[0].name

    matches = sorted(backlight.iterdir()) if backlight.exists() else []
    if matches:
        return matches[0].name

    return DEFAULT_DEVICE


def raw_values(device: str) -> tuple[int, int]:
    current = int(output(["brightnessctl", "-d", device, "g"]))
    maximum = int(output(["brightnessctl", "-d", device, "m"]))
    return current, max(1, maximum)


def raw_to_linear(raw: int, maximum: int) -> float:
    min_norm = max(0.0, min(0.99, MIN_LINEAR / 100.0))
    hw = max(0.0, min(1.0, raw / maximum))
    if hw <= min_norm:
        return MIN_LINEAR

    linear_norm = pow((hw - min_norm) / (1.0 - min_norm), 1.0 / GAMMA)
    return MIN_LINEAR + linear_norm * (100.0 - MIN_LINEAR)


def linear_to_raw(linear: float, maximum: int) -> int:
    linear = max(MIN_LINEAR, min(100.0, linear))
    min_norm = max(0.0, min(0.99, MIN_LINEAR / 100.0))
    linear_norm = (linear - MIN_LINEAR) / (100.0 - MIN_LINEAR)
    hw = min_norm + pow(linear_norm, GAMMA) * (1.0 - min_norm)
    raw = int(round(hw * maximum))
    minimum_raw = int(math.ceil(min_norm * maximum))
    return max(minimum_raw, min(maximum, raw))


def current_linear(device: str) -> float:
    current, maximum = raw_values(device)
    return raw_to_linear(current, maximum)


def parse_percent(value: str) -> float:
    return float(value.strip().rstrip("%"))


def target_linear(device: str, step: str) -> float:
    current = current_linear(device)

    if step == "raise":
        return current + 5.0
    if step == "lower":
        return current - 5.0

    if step.startswith("+"):
        return current + parse_percent(step[1:])
    if step.endswith("-"):
        return current - parse_percent(step[:-1])
    if step.startswith("-"):
        return current - parse_percent(step[1:])

    return parse_percent(step)


def focused_monitor() -> str | None:
    try:
        monitors = json.loads(output(["hyprctl", "monitors", "-j"]))
    except Exception:
        return None

    for monitor in monitors:
        if monitor.get("focused"):
            return monitor.get("name")
    return None


def show_osd(percent: float) -> None:
    shown = int(round(max(MIN_LINEAR, min(100.0, percent))))
    progress = max(0.01, min(1.0, shown / 100.0))
    cmd = [
        "swayosd-client",
        "--custom-icon",
        "display-brightness-symbolic",
        "--custom-progress",
        f"{progress:.2f}",
        "--custom-progress-text",
        f"{shown}%",
    ]
    monitor = focused_monitor()
    if monitor:
        cmd.extend(["--monitor", monitor])
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def set_linear(device: str, linear: float, osd: bool = True) -> float:
    linear = max(MIN_LINEAR, min(100.0, linear))
    _, maximum = raw_values(device)
    subprocess.run(
        ["brightnessctl", "-d", device, "set", str(linear_to_raw(linear, maximum))],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if osd:
        show_osd(linear)
    return linear


def apple_focused() -> bool:
    helper = STOCK_BIN / "omarchy-hyprland-monitor-focused-apple"
    return helper.exists() and subprocess.run([str(helper)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def call_apple(step: str) -> None:
    helper = STOCK_BIN / "omarchy-brightness-display-apple"
    subprocess.run([str(helper), step], check=False)


def usage() -> None:
    print(
        "Usage: omarchy-brightness-display <+N%|N%-|N%|raise|lower|off|on|get|min> [device]",
        file=sys.stderr,
    )


def main() -> int:
    step = sys.argv[1] if len(sys.argv) > 1 else "+5%"
    device = choose_device(sys.argv[2] if len(sys.argv) > 2 else None)

    if step in {"-h", "--help", "help"}:
        usage()
        return 0

    if step == "off":
        subprocess.run(["hyprctl", "dispatch", "dpms", "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    if step == "on":
        subprocess.run(["hyprctl", "dispatch", "dpms", "on"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0

    if step == "get":
        print(int(round(max(MIN_LINEAR, min(100.0, current_linear(device))))))
        return 0

    if step == "get-raw":
        current, maximum = raw_values(device)
        print(f"{current}/{maximum}")
        return 0

    if step == "min":
        print(int(round(MIN_LINEAR)))
        return 0

    if apple_focused():
        call_apple(step)
        return 0

    try:
        set_linear(device, target_linear(device, step), osd=True)
    except (ValueError, subprocess.CalledProcessError):
        usage()
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
